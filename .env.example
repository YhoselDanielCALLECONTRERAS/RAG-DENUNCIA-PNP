# Variables de entorno — SistemaRAG · Denuncias Patrimoniales
# ⚠️  NUNCA subir este archivo a control de versiones (ya está en .gitignore)
# Copie este archivo como .env y configure sus valores reales.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── LLM Configuration ─────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=text-embedding-3-small

# ── RAG Pipeline ──────────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.35

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME=codigo_penal_peruano

# ── Entorno ───────────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
